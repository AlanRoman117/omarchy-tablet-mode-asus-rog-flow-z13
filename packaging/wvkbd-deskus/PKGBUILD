# Maintainer: Alan Roman
#
# wvkbd with a US desktop layout, for the omarchy-tablet-mode plugin: upstream's 0.20
# release (the same one the AUR wvkbd package builds, same checksum) with three patches.
#   deskus-layout.patch: the deskintl layout with the Compose key taken off the home row,
#     so Caps Lock starts it like on a real keyboard; Caps and Enter are 1.75 keys wide.
#   hold-until-release.patch: a held key stays down until the finger lifts instead of
#     letting go on the slightest movement, so hold-to-talk keys work. Since nothing
#     releases it early any more, it's also released when the touch is cancelled and when
#     the keyboard hides (which covers rotation and resize). Hiding also cancels the key
#     popup's pending frame callback, which that release queues (0.20-6: it crashed).
#     When the compositor closes the keyboard (its output went away), it's torn down
#     the same way, so the key is released and no pointer is left dangling (0.20-7).
#   stay-on-output.patch: --output NAME keeps the keyboard on one output. Upstream lets
#     the compositor pick one on every resize, so a docked tablet's keyboard jumped to the
#     focused external monitor whenever it rotated.
#
# Licences: wvkbd is GPL v3.0 (upstream's COPYING; no "or later"), and the three patches,
# derived from it, are too. Upstream's os-compatibility.c, built into the binary, is MIT
# (COPYING_WESTON). This PKGBUILD itself is MIT, like the rest of the plugin.
# Installs only /usr/bin/wvkbd-deskus, so it sits beside the AUR wvkbd package.

pkgname=wvkbd-deskus
pkgver=0.20
pkgrel=7
pkgdesc='On-screen keyboard for wlroots, US desktop layout (for omarchy-tablet-mode)'
url='https://git.sr.ht/~proycon/wvkbd'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only' 'MIT')
depends=('wayland' 'pango' 'cairo' 'glibc' 'libxkbcommon')
makedepends=('fontconfig')
options=('!debug')
source=("wvkbd-$pkgver.tar.gz::https://git.sr.ht/~proycon/wvkbd/archive/v$pkgver.tar.gz"
        'deskus-layout.patch'
        'hold-until-release.patch'
        'stay-on-output.patch')
sha512sums=('1c5204dc00f7a3bdfd199dfa88b513c46249b7832ba546c0554940539fcc4e0d55303a9f6edd17dd82fd2893b602b86395202311b3ec851f5e8f41895f682371'
            'cb5c7320e2a794f9cc37f62bec69baed7b46b6e8f28d96b95c37227ed6b60f8ab2f961863b8293f54654227ff429d690a2572888f4d060600ae82b3debf96074'
            '165bf98541b0c2be5f8ede7e64911e79abed5e9af583ba276e1b55563eedc91ba399026fcbd506c89f496fde889a7c0d2fa52e23734583fd2ee4437f8f9cee63'
            '968c345c87d35f399061da525d76c3a9bb2c6f8078ded457334d787d2185c9a1a4381b81d5fc3a3d84f90dbb78cc8264c20dfe57cbf0d5138da96956a81077d8')

prepare() {
  cd "wvkbd-v$pkgver"
  cp layout.deskintl.h layout.deskus.h
  cp keymap.deskintl.h keymap.deskus.h
  cp config.deskintl.h config.deskus.h
  patch layout.deskus.h <"$srcdir/deskus-layout.patch"
  patch -p1 <"$srcdir/hold-until-release.patch"
  patch -p1 <"$srcdir/stay-on-output.patch"
}

build() {
  make -C "wvkbd-v$pkgver" LAYOUT=deskus wvkbd-deskus
}

package() {
  install -Dm755 "wvkbd-v$pkgver/wvkbd-deskus" "$pkgdir/usr/bin/wvkbd-deskus"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "wvkbd-v$pkgver/LICENSE" "wvkbd-v$pkgver/COPYING" "wvkbd-v$pkgver/COPYING_WESTON"
}
