# Maintainer: Alan Roman
#
# wvkbd with a US desktop layout, for the omarchy-tablet-mode plugin. Upstream's
# deskintl layout (the same 0.20 release the AUR wvkbd package builds, same
# checksum) with one change: the Compose key is taken off the home row, so Caps
# Lock starts it like on a real keyboard (deskus-layout.patch), and a held key
# stays down until the finger lifts instead of letting go on the slightest
# movement, so hold-to-talk keys work. Because nothing releases it early any more,
# the same patch also lets go of a held key when the touch is cancelled or the
# keyboard hides or resizes (hold-until-release.patch). Finally, --output NAME
# keeps the keyboard on one output (stay-on-output.patch); upstream lets the
# compositor pick one on every resize, so a docked tablet's keyboard jumped to the
# focused external monitor whenever it rotated.
#
# wvkbd is GPL-3.0; both patches are derived from it and are GPL-3.0 too.
# Installs only /usr/bin/wvkbd-deskus, so it sits beside the AUR wvkbd package.

pkgname=wvkbd-deskus
pkgver=0.20
pkgrel=4
pkgdesc='On-screen keyboard for wlroots, US desktop layout (for omarchy-tablet-mode)'
url='https://git.sr.ht/~proycon/wvkbd'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('wayland' 'pango' 'cairo' 'glibc' 'libxkbcommon')
makedepends=('fontconfig')
options=('!debug')
source=("wvkbd-$pkgver.tar.gz::https://git.sr.ht/~proycon/wvkbd/archive/v$pkgver.tar.gz"
        'deskus-layout.patch'
        'hold-until-release.patch'
        'stay-on-output.patch')
sha512sums=('1c5204dc00f7a3bdfd199dfa88b513c46249b7832ba546c0554940539fcc4e0d55303a9f6edd17dd82fd2893b602b86395202311b3ec851f5e8f41895f682371'
            '82b018ee68e395ecca9550b8f393b886d0b17082e386aea1ecbea6642e2d04a8eefff2ad69fa221241218bb69f25e434bc715f9fae0cd2cc2a5e1fbffa24b147'
            '3fc96cb917f202ed34c5e73f9a32c5a6114a7cf06c27e336df43708f0396525f15a1797033b4a075841b5bd7d5478526b4954ccf4b2d47953f04a7bdc82a678d'
            '047783dc8f48456771051bb2bc3f448b0c4aa622ea1b32b36ac9bcc7b38bbcd4a55b9051b6a9dc165cebc21bcf32cdf7d6449abede0fa720a8923817505413e4')

prepare() {
  cd "wvkbd-v$pkgver"
  cp layout.deskintl.h layout.deskus.h
  cp keymap.deskintl.h keymap.deskus.h
  cp config.deskintl.h config.deskus.h
  patch layout.deskus.h <"$srcdir/deskus-layout.patch"
  patch -p1 <"$srcdir/hold-until-release.patch"
  patch -p1 <"$srcdir/stay-on-output.patch"
}

build() {
  make -C "wvkbd-v$pkgver" LAYOUT=deskus wvkbd-deskus
}

package() {
  install -Dm755 "wvkbd-v$pkgver/wvkbd-deskus" "$pkgdir/usr/bin/wvkbd-deskus"
  install -Dm644 "wvkbd-v$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
