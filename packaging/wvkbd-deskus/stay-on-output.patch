--output NAME keeps the keyboard's layer surface on one output (wl_output v4 name).
Part of the wvkbd-deskus recipe in alanroman117.tablet-mode; derived from wvkbd 0.20
(https://git.sr.ht/~proycon/wvkbd), whose COPYING puts it under the GPL v3.0.

--- a/main.c
+++ b/main.c
@@ -75,6 +75,13 @@
 static bool hidden = false;
 static bool im_auto = false;
 
+/* omarchy-tablet-mode: --output NAME keeps the keyboard on that output. Without it the
+ * compositor picks one each time the surface is (re)created, which follows focus and so
+ * moves the keyboard to another monitor on every resize or rotation. */
+static char *target_output_name = NULL;
+static struct wl_output *target_output = NULL;
+static uint32_t target_output_global = 0;
+
 /* event handler prototypes */
 static void wl_pointer_enter(void *data, struct wl_pointer *wl_pointer,
                              uint32_t serial, struct wl_surface *surface,
@@ -437,10 +444,71 @@
     .ping = xdg_wm_base_ping,
 };
 
+static void
+output_geometry(void *data, struct wl_output *wl_output, int32_t x, int32_t y,
+                int32_t pw, int32_t ph, int32_t subpixel, const char *make,
+                const char *model, int32_t transform)
+{
+}
+
+static void
+output_mode(void *data, struct wl_output *wl_output, uint32_t flags, int32_t w,
+            int32_t h, int32_t refresh)
+{
+}
+
+static void
+output_done(void *data, struct wl_output *wl_output)
+{
+}
+
+static void
+output_scale(void *data, struct wl_output *wl_output, int32_t factor)
+{
+}
+
+static void
+output_name(void *data, struct wl_output *wl_output, const char *name)
+{
+    if (target_output_name && strcmp(name, target_output_name) == 0) {
+        if (target_output && target_output != wl_output) {
+            wl_output_release(target_output);
+        }
+        target_output = wl_output;
+        target_output_global = (uint32_t)(uintptr_t)data;
+    } else {
+        wl_output_release(wl_output);
+    }
+}
+
+static void
+output_description(void *data, struct wl_output *wl_output,
+                   const char *description)
+{
+}
+
+static const struct wl_output_listener output_listener = {
+    .geometry = output_geometry,
+    .mode = output_mode,
+    .done = output_done,
+    .scale = output_scale,
+    .name = output_name,
+    .description = output_description,
+};
+
 void
 handle_global(void *data, struct wl_registry *registry, uint32_t name,
               const char *interface, uint32_t version)
 {
+    if (target_output_name && version >= 4 &&
+        strcmp(interface, wl_output_interface.name) == 0) {
+        struct wl_output *output =
+            wl_registry_bind(registry, name, &wl_output_interface, 4);
+        wl_output_add_listener(output, &output_listener,
+                               (void *)(uintptr_t)name);
+        return;
+    }
+
     if (strcmp(interface, wl_compositor_interface.name) == 0) {
         compositor =
             wl_registry_bind(registry, name, &wl_compositor_interface, 6);
@@ -474,6 +542,13 @@
 void
 handle_global_remove(void *data, struct wl_registry *registry, uint32_t name)
 {
+    /* The target output went away (a laptop panel switched off): fall back to the
+     * compositor's choice until it comes back and is announced again. */
+    if (target_output && name == target_output_global) {
+        wl_output_release(target_output);
+        target_output = NULL;
+        target_output_global = 0;
+    }
 }
 
